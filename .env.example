# Copy to .env and fill in. Never commit .env.
PSEUDO_KEY=change-me
# Depuis une VM VirtualBox en NAT, l'hôte Windows est vu en 10.0.2.2 : OLLAMA_HOST=http://10.0.2.2:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text
# Délai maximal d'un appel à Ollama, en secondes
OLLAMA_TIMEOUT=300
DRY_RUN=true
